{
  "expo": {
    "name": "ClickSeekers",
    "slug": "ClickSeekers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/clickseekers.png",
    "scheme": "clickseekers",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ClickSeekers"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/clickseekers.png",
        "backgroundImage": "./assets/images/clickseekers.png",
        "monochromeImage": "./assets/images/clickseekers.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ClickSeekers",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/clickseekers.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clickseekers.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ClickSeekers to use your location to show the route to events.",
          "locationAlwaysAndWhenInUsePermission": "Allow ClickSeekers to use your location to show the route to events."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b58b043-1ca7-4a89-9659-d386329cf5fd"
      }
    },
    "owner": "clickseekers"
  }
}
